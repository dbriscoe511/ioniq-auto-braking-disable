	)
	(text_box "1. BTN = CON1-5, Parking Safety switch (~200R to GND in the panel), 12.2 V idle. Q1 + R3 emulate a press (in car: GPIO3 ~2.5 V released, ~0.1 V pressed).\n2. CAN is silent by default: R6 holds S high and firmware keeps it high (listen-only). No 120R termination on this board.\n3. GPIO2/8/9 are strapping pins, held high by R11/R10/R9 (BOOT pulls GPIO9 low). D3 on GPIO1 is the board LED.\n4. Every part has an LCSC field for JLC assembly."
		(exclude_from_sim no)
		(at 15.24 140.97 0)
		(size 160.02 13.97)
		(margins 1.27 1.27 1.27 1.27
		)
		(stroke
			(width 0.1524)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "90943cf2-a23b-5e47-a2be-5ca3ab10706a")
	)
